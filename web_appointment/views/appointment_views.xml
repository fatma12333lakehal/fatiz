<odoo>

    <record id="view_appointment_tree" model="ir.ui.view">
        <field name="name">appointment.list</field>
        <field name="model">website.appointment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="time"/>
            </list>
        </field>
    </record>

    <record id="view_appointment_form" model="ir.ui.view">
        <field name="name">appointment.form</field>
        <field name="model">website.appointment</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="date"/>
                    <field name="time"/>

                </group>
            </form>
        </field>
    </record>



    <record id="action_appointments" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">website.appointment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>